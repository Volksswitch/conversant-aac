# Research materials and working documents (stay on OneDrive only)
Other/
*.docx
*.msg
*.url
*.pdf
Architecture Diagrams.html

# Local user data (synced by OneDrive between machines, not by git)
userdata/

# OS artifacts
Thumbs.db
Desktop.ini
.DS_Store

# Editor artifacts
*.swp
*.swo
*~
.vscode/
.idea/

# Claude Code local state
.claude/

# Node (local dev tooling only)
node_modules/

# Experimental / throwaway app copies — kept locally, NEVER deployed or committed.
# Only app/ is published (see .github/workflows/deploy.yml), so nothing here can
# reach users; this keeps the stale experiment out of the public repo entirely.
experiments/
# Hard guard (SEC-4): the "-Helix2" experiment must never live inside the deploy
# root again — a stray `git add` there would publish a stale, unescaped copy.
app/**/*-Helix2*

# Local document-editing working files and one-off scripts (SEC-10). The unpacked_*
# dirs hold extracted internals of internal Word docs; keep them out of the public repo.
__pycache__/
unpacked_*/
cleanup_docx.py
edit_docx.py

# Pre-edit backups of the product documents (made before each "sync docs" pass).
# The .docx are already ignored; this keeps the folder + its README out of git too.
Doc Backups/

# API key for the Tier-3 live scenario tests (tests/live.test.mjs). Ken supplies
# this file; it holds a real Anthropic key and must NEVER be committed. Belt and
# suspenders: match the bare file and any variant.
.anthropic-key
.anthropic-key.*
tests/.anthropic-key*

# Same again for the Deepgram key used by scripts/deepgram-pronunciation-probe.mjs.
# The wildcards are deliberately loose: this repo is committed with `git add -A`, so
# a key file whose name is slightly off from the one expected would otherwise be
# swept in, and a leaked key cannot be un-leaked by a later commit.
.deepgram-key
.deepgram-key.*
*deepgram*key*
*dg-key*

# Same again for the OpenAI key used by scripts/test-openai-speech.mjs. The wide
# patterns are deliberate for the same reason as above: a key file whose name is
# slightly off would otherwise be swept in, and a leaked key cannot be un-leaked.
.openai-key
.openai-key.*
*openai*key*
*oai-key*

# Audio written by scripts/test-openai-speech.mjs so the voice can be listened to.
scripts/hello.mp3
deepgram-probe-audio/

# Exported beta reports and anything saved out of the Sheet.
#
# (!) THESE CARRY PERSONAL DATA AND THE REPO IS PUBLIC. A reports export names every
# tester; a problems export additionally carries the full text of what they sent,
# which is the ONE payload allowed to contain transcripts of real conversations -
# their communication partners' words included, and those people never agreed to
# anything. Committing one would publish all of it, permanently, in the history.
# The folder is where the reading tool looks first, so the ignore has to be here
# rather than left to habit.
Reports/
