  "_bannedTerms": [
    "Terms that must not appear in a document a user reads. 'severity' is honest about",
    "which can be decided by a machine: ERROR is unambiguous, REVIEW needs a person to",
    "read the sentence because the word has innocent uses too."
  ],
  "bannedTerms": [
    {
      "term": "chip",
      "use": "choice button (the partner's alternatives) or answer button (About Me)",
      "why": "designer vocabulary from Google's design system; not general English",
      "severity": "error"
    },
    {
      "term": "Preferred",
      "use": "describe the response instead of naming the category",
      "why": "Conversation Analysis category names are removed from user documents (comment 33)",
      "severity": "review"
    },
    {
      "term": "Dispreferred",
      "use": "describe the response instead of naming the category",
